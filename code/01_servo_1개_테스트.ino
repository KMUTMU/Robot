// ========================================
// 01. 서보 1개 기본 테스트
// ========================================
// 가장 처음 성공한 코드!
// 서보 1개를 0도 -> 90도 -> 180도 반복 이동
//
// 배선:
//   서보 주황(신호) -> ESP32 P13
//   서보 빨강(전원) -> ESP32 5V (또는 빵판 +레일)
//   서보 갈색(접지) -> ESP32 GND
// ========================================

#include <ESP32Servo.h>

Servo myServo;

void setup() {
  myServo.attach(13);     // 서보 신호선 = 13번 핀
}

void loop() {
  myServo.write(0);       // 0도
  delay(1000);
  myServo.write(90);      // 90도
  delay(1000);
  myServo.write(180);     // 180도
  delay(1000);
}
